# Copy this file to .env and fill in your own Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

# Safe to expose in frontend code (protected by Row Level Security):
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NEVER put the service_role key in this file or anywhere in frontend code.
# It bypasses Row Level Security. If you need it (e.g. for an account-deletion
# Edge Function), it belongs only in Supabase's server-side environment
# (Edge Function secrets), never in .env used by the Vite frontend.
